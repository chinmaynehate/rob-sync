# .env file

# SSH password to connect to the Raspberry Pi
SSH_PASSWORD="123"

# Password for connecting to the Raspberry Pi's Wi-Fi hotspot
WIFI_PASSWORD="00000000"

# SSID and password of the main Wi-Fi network to reconnect to
MAIN_WIFI_SSID="Cdn"
MAIN_WIFI_PASSWORD="chinmay@123"

# Number of retry attempts before giving up on a Raspberry Pi
MAX_RETRIES=3

# Log file for storing script output
LOGFILE="update_log.txt"

# URL to download the latest client_udp_test.py file via wget
WGET_URL="https://raw.githubusercontent.com/chinmaynehate/rob-sync/b85277111488a0be728b8b11567c715127fc47d4/client_udp_test.py"
# WGET_URL="https://raw.githubusercontent.com/chinmaynehate/rob-sync/refs/heads/client/pid.py"
